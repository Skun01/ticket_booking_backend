# Copy file này thành .env (đã được gitignore), bỏ dấu # ở biến cần dùng rồi điền giá trị.
# App tự đọc .env qua spring.config.import, biến môi trường thật được ưu tiên hơn.
# Lưu ý: biến để trống (VD: JWT_SECRET=) vẫn tính là đã khai báo và sẽ đè giá trị mặc định của profile dev,
# vì vậy biến nào không dùng thì giữ nguyên dấu #.
# Profile không đặt được trong file này, hãy đặt SPRING_PROFILES_ACTIVE trong biến môi trường hoặc run config của IDE.

# DB_URL=jdbc:mysql://localhost:3306/base_project
# DB_USERNAME=root
# DB_PASSWORD=

# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Tạo bằng lệnh: openssl rand -base64 32
# JWT_SECRET=

# Danh sách origin của frontend, phân tách bằng dấu phẩy, hỗ trợ pattern (VD: https://*.example.com, http://localhost:[*])
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200

# Tài khoản ADMIN được tạo khi khởi động nếu email chưa tồn tại
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Cấu hình cổng thanh toán payOS
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# PAYOS_RETURN_URL=http://localhost:5173/payment/success
# PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
